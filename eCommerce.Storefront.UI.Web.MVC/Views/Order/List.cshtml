@{
    Layout = "CustomerAccount";
    ViewData["Title"] = "Your Order History";
}

@model eCommerce.Storefront.Controllers.ViewModels.CustomerAccount.CustomersOrderSummaryView

<h2>Your Orders</h2>    
<ul>
    @foreach(var order in Model.Orders)
    {
        <li>
            @order.Created.ToLocalTime().ToLongDateString() 

            @if (order.IsSubmitted == false)
            {
                <form method="post" action="@Url.Action("CreatePaymentFor", "Payment", new { orderId = order.Id })" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit">Pay</button>
                </form>
            }
            
            @Html.ActionLink("View Detail", "Detail", "Order", new { orderId = order .Id}, null)
        </li>    
    }
</ul>