@{
    ViewData["Title"] = "Your Basket";
    Layout = "ProductCatalog";
}

@model eCommerce.Storefront.Controllers.ViewModels.ProductCatalog.BasketDetailView

<script type="text/javascript" nonce="@(Context.Items["CspNonce"])">
    // Any basket AJAX call that fails (e.g. server returns 400 for a zero qty) must
    // clear the overlays, otherwise the semi-transparent cover stays up and the page
    // is stuck until a full reload.
    function onBasketUpdateFailed(jqXHR) {
        hideOverlay("overlay");
        hideOverlay("smoverlay");
        alert("Your basket could not be updated. Please check the quantities you entered and try again.");
    }

    function removeItem(productId) {
        var postData = { productId: productId };

        showOverlay("overlay", "main");
        showOverlay("smoverlay", "basketSummary");
        $.post('/Basket/RemoveItem', postData, updateBasket, "json").fail(onBasketUpdateFailed);
    }

    function updateItemQtys() {
        showOverlay("overlay", "main");
        showOverlay("smoverlay", "basketSummary");

        var postData;
        var postArr = [];
        var index = 0;

        $("[id^='Qty-']").each(function() {
            itemElementId = $(this).attr('id');
            var productId = 0;
            productId = itemElementId.replace("Qty-", "");
            postArr[index] = { 'productId': productId, 'qty': $(this).val() }
            index++;
        });

        postData = { Items: postArr };
        var jsonData = JSON.stringify(postData);

        $.ajax({
            url: '@Url.Action("UpdateItems", "Basket")',
            type: 'POST',
            dataType: 'json',
            data: jsonData,
            contentType: 'application/json; charset=utf-8',
            success: updateBasket,
            error: onBasketUpdateFailed
        });
    }

    function updateShippingService(ddlShippingService) {
        var postData = { shippingServiceId: $(ddlShippingService).val() };

        showOverlay("overlay", "main");
        showOverlay("smoverlay", "basketSummary");
        $.post('/Basket/UpdateShipping', postData, updateBasket, "json").fail(onBasketUpdateFailed);
    }

    // The basket is rebuilt with DOM APIs and .text() rather than a client-side
    // template engine. Untrusted values (admin-entered product/shipping names)
    // therefore become text nodes, never markup, and the page no longer needs
    // jTemplates (or 'unsafe-eval' in the Content-Security-Policy).
    function renderBasket(view) {
        var basket = (view && view.basket) || {};
        var items = basket.items || [];
        var deliveryOptions = (view && view.deliveryOptions) || [];

        var $table = $("<table>").attr("width", "100%");

        var $headerRow = $("<tr>");
        $("<th>").attr("id", "product").text("Product").appendTo($headerRow);
        $("<th>").attr("id", "qty").text("Qty").appendTo($headerRow);
        $("<th>").attr("id", "price").css("text-align", "right").text("Price").appendTo($headerRow);
        $("<th>").attr("id", "total").css("text-align", "right").text("Total").appendTo($headerRow);
        $table.append($headerRow);
        $table.append($("<tr>").append($("<td>").attr("colspan", "4").append($("<hr/>"))));

        $.each(items, function (_, item) {
            if (!item) {
                return;
            }

            var $row = $("<tr>");

            var $productCell = $("<td>");
            $("<span>").text(item.productName + " - " + item.productSizeName).appendTo($productCell);
            $productCell.append($("<br/>"));
            $("<a>").attr("href", "#")
                .addClass("remove-item")
                .attr("data-product-id", item.productId)
                .text("remove this item")
                .appendTo($productCell);
            $row.append($productCell);

            var $qtyCell = $("<td>");
            $("<input>").addClass("itemQtyBox")
                .attr("id", "Qty-" + item.productId)
                .attr("type", "text")
                .val(item.qty)
                .appendTo($qtyCell);
            $row.append($qtyCell);

            $("<td>").css("text-align", "right").text(item.productPrice).appendTo($row);
            $("<td>").css("text-align", "right").text(item.lineTotal).appendTo($row);

            $table.append($row);
        });

        var $updateRow = $("<tr>");
        $updateRow.append($("<td>"));
        var $updateCell = $("<td>");
        $("<a>").attr("href", "#").addClass("update-qtys").text("update").appendTo($updateCell);
        $updateRow.append($updateCell);
        $updateRow.append($("<td>"));
        $updateRow.append($("<td>"));
        $table.append($updateRow);
        $table.append($("<tr>").append($("<td>").attr("colspan", "4").append($("<hr/>"))));

        var $basketTotalRow = $("<tr>");
        $basketTotalRow.append($("<td>").css("text-align", "right").attr("colspan", "3").text("Basket: "));
        $basketTotalRow.append($("<td>").css("text-align", "right").text(basket.itemsTotal));
        $table.append($basketTotalRow);

        var $shippingRow = $("<tr>");
        var $shippingLabelCell = $("<td>").css("text-align", "right").attr("colspan", "3").text("Shipping: ");
        var $shippingSelect = $("<select>").addClass("item-sortdropdown")
            .attr("name", "ddlShippingService")
            .attr("id", "ddlShippingService");
        $.each(deliveryOptions, function (_, option) {
            if (!option) {
                return;
            }

            $("<option>").val(option.id)
                .text(option.shippingServiceDescription)
                .prop("selected", option.id === basket.deliveryOptionId)
                .appendTo($shippingSelect);
        });
        $shippingLabelCell.append($shippingSelect);
        $shippingRow.append($shippingLabelCell);
        $shippingRow.append($("<td>").css("text-align", "right").text(basket.deliveryCost));
        $table.append($shippingRow);

        var $totalRow = $("<tr>");
        $totalRow.append($("<td>").css("text-align", "right").attr("colspan", "3").text("Total: "));
        $totalRow.append($("<td>").css("text-align", "right").text(basket.basketTotal));
        $table.append($totalRow);

        var $checkoutRow = $("<tr>");
        $checkoutRow.append($("<td>").attr("colspan", "3"));
        var $checkoutCell = $("<td>").css("text-align", "right");
        $("<a>").attr("href", '@Url.Action("Checkout", "Checkout")').text("Check Out").appendTo($checkoutCell);
        $checkoutRow.append($checkoutCell);
        $table.append($checkoutRow);

        $("#basketDisplay").empty().append($table);
    }

    function updateBasket(basketDetailView) {
        if (basketDetailView.basketSummary.numberOfItems == 0) {
            $("#basketDisplay").text("You have no items in your basket.");
        } else {
            renderBasket(basketDetailView);
        }

        updateBasketSummary(basketDetailView.basketSummary);
        hideOverlay("overlay");
        hideOverlay("smoverlay");
    }

    // Delegated handlers replace javascript: links and inline on* attributes,
    // which CSP treats as inline script.
    $(document).ready(function () {
        $(document).on("click", ".remove-item", function (event) {
            event.preventDefault();
            removeItem($(this).attr("data-product-id"));
        });

        $(document).on("click", ".update-qtys", function (event) {
            event.preventDefault();
            updateItemQtys();
        });

        $(document).on("change", "#ddlShippingService", function () {
            updateShippingService(this);
        });
    });
</script>

<h2>Your Basket</h2>
@if (Model.Basket.Items.Count() > 0)
{
    <div id="overlay" class="overlay"></div>
    <div id="basketDisplay">
        <table style="width: 100%">
            <tr>
                <th id="product">Product</th>
                <th id="qty">Qty</th>
                <th id="price" style="text-align: right">Price</th>
                <th id="total" style="text-align: right">Total</th>
            </tr>
            <tr>
                <td colspan="4"><hr /></td>
            </tr>
            @foreach (var item in Model.Basket.Items) 
            {
                <tr>
                    <td>@item.ProductName - @item.ProductSizeName<br />
                        <a href="#" class="remove-item" data-product-id="@item.ProductId">remove this item</a>
                    </td>
                    <td>@Html.TextBox("Qty-" + item.ProductId.ToString(), item.Qty, new { @class = "itemQtyBox" })</td>
                    <td style="text-align: right">@item.ProductPrice</td>
                    <td style="text-align: right">@item.LineTotal</td>
                </tr>
            }
            <tr>
                <td></td>
                <td><a href="#" class="update-qtys">update</a></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td colspan="4"><hr /></td>
            </tr>
            <tr>
                <td style="text-align: right" colspan="3">Basket: </td>
                <td style="text-align: right">@Model.Basket.ItemsTotal</td>
            </tr>
            <tr>
                <td style="text-align: right" colspan="3">Shipping:
                    <select class="item-sortdropdown" name="ddlShippingService" id="ddlShippingService">
                    @foreach (var deliveryOption in Model.DeliveryOptions)
                    {
                        <option value="@deliveryOption.Id" @if (Model.Basket.DeliveryOptionId == deliveryOption.Id) { <text>selected</text> } >
                            @deliveryOption.ShippingServiceDescription
                        </option>
                    }
                    </select>
                </td>
                <td style="text-align: right">@Model.Basket.DeliveryCost</td>
            </tr>
            <tr>
                <td style="text-align: right" colspan="3"> Total: </td>
                <td style="text-align: right">@Model.Basket.BasketTotal</td>
            </tr>
            <tr>
                <td colspan="3"></td>
                <td style="text-align: right">
                    @Html.ActionLink("Check Out", "Checkout", "Checkout")
                </td>
            </tr>
        </table>
    </div>
<p></p>
}
else
{
    <text>You have no items in your basket.</text>
}
