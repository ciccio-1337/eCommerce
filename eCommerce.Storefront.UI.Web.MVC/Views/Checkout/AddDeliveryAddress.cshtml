@{
    Layout = "Checkout";
    ViewData["Title"] = "Add Delivery Address";
}

@model eCommerce.Storefront.Services.ViewModels.DeliveryAddressView

@if (!string.IsNullOrWhiteSpace(ViewData["IssueMessage"]?.ToString()))
{
    <p>
        <div style="color: #D63301; background-color: #FFCCBA; padding:15px 10px 15px 50px;">
            @ViewData["IssueMessage"]
        </div>
    </p>
}

<h2>Add Delivery Address</h2>    
@using (Html.BeginForm("AddDeliveryAddress", "Checkout"))
{
    @await Html.PartialAsync("~/Views/Shared/AddressEdit.cshtml", Model)
    <p>
        <input type="submit" value="Create Address and Checkout" />
    </p>        
}
<div>
    @Html.ActionLink("Check Out", "Checkout", "Checkout")
</div><br />