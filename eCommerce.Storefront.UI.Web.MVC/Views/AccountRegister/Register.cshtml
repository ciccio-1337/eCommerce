@{
    Layout = "Site";
    ViewData["Title"] = "Register";
}

@model eCommerce.Storefront.Controllers.ViewModels.Account.AccountView

@if (Model.HasIssue) 
{
    <p>
        <div style="color: #D63301; background-color: #FFCCBA; padding:15px 10px 15px 50px;" >
            @Model.Message
        </div>
    </p>
}

<h2>Don't have an account? Create it.</h2>

@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()
    @Html.Hidden("returnUrl", ViewData["ReturnUrl"]?.ToString())
    <div>
        <p>
            <label for="Email">Email</label><br />
            @Html.TextBox("Email", ViewData["Email"]?.ToString())
        </p>
        <p>
            <label for="Password">Password</label><br />
            @Html.Password("Password", null, new { @autocomplete = "off" })
        </p>
        <p>
            <label for="FirstName">First Name</label><br />
            @Html.TextBox("FirstName", ViewData["FirstName"]?.ToString())
        </p>
        <p>
            <label for="SecondName">Second Name</label><br />
            @Html.TextBox("SecondName", ViewData["SecondName"]?.ToString())
        </p>
        <p>
            <input type="submit" value="Register" />
        </p>
    </div>
}