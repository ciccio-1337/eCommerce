@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ILoginService LoginService

<AuthorizeView>
    <Authorized>
        <a>Hello, @context.User.Identity.Name!</a>
        <a class="nav-link btn btn-link" @onclick="Logout" style="cursor: pointer">Log out</a>
    </Authorized>
</AuthorizeView>

@code {
    async Task Logout()
    {
        try
        {
            await Http.PostAsync("api/accounts/logout", null);
        }
        catch (Exception)
        {
            // The server cookie may already be gone; clear the local state regardless.
        }

        await LoginService.LogoutAsync();

        NavigationManager.NavigateTo("/admin/account/login", forceLoad: true);
    }
}