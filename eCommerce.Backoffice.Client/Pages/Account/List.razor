@page "/admin/account/list"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<Alert Title="@error" ErrorList="new List<string>()" CSSClass="danger" />

<Grid Model="model" Title="Accounts" ElementsType="UserListItem" OnCreate="@(() => NavigationManager.NavigateTo("/admin/account/register"))" CanEdit="false" OnDelete="@((item) => DeleteAccountAsync(item as UserListItem))" />

@code {
    string route = "api/accounts";
    GridModel<UserListItem> model;
    string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var accounts = await HttpClient.GetFromJsonAsync<List<UserListItem>>(route);

            model = new GridModel<UserListItem>
            {
                Rows = accounts ?? new List<UserListItem>(),
                UseAnnotations = true
            };
        }
        catch (Exception)
        {
            model = new GridModel<UserListItem>
            {
                Rows = new List<UserListItem>(),
                UseAnnotations = true
            };
        }
    }

    async Task DeleteAccountAsync(UserListItem item)
    {
        if (item?.Id == null)
        {
            return;
        }

        try
        {
            var httpResponseMessage = await HttpClient.DeleteAsync($"{route}/{item.Id}");

            if (httpResponseMessage != null && httpResponseMessage.IsSuccessStatusCode)
            {
                error = null;
                
                model.Rows.Remove(item);

                var rows = model.Rows.ToList();

                model = new GridModel<UserListItem>
                {
                    Rows = rows,
                    UseAnnotations = true
                };
            }
            else
            {
                error = "The account could not be deleted. It may already have been removed.";
            }
        }
        catch (Exception)
        {
            error = "Unable to reach the server. Please try again.";
        }
    }
}

