@page "/admin/brand/list"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<Alert Title="@error" ErrorList="new List<string>()" CSSClass="danger" />

<Grid Model="model" Title="Brands" ElementsType="BrandDto" OnCreate="@(() => NavigationManager.NavigateTo("/admin/brand/detail"))" OnEdit="@((item) => NavigationManager.NavigateTo($"/admin/brand/detail/{(item as BrandDto)?.Id}"))" OnDelete="@((item) => DeleteBrandAsync(item as BrandDto))" />

@code {
    string route = "api/brands";
    GridModel<BrandDto> model;
    string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var brands = await HttpClient.GetFromJsonAsync<List<BrandDto>>(route);

            model = new GridModel<BrandDto>
            {
                Rows = brands ?? new List<BrandDto>(),
                UseAnnotations = true
            };
        }
        catch (Exception)
        {
            model = new GridModel<BrandDto>
            {
                Rows = new List<BrandDto>(),
                UseAnnotations = true
            };
        }
    }

    async Task DeleteBrandAsync(BrandDto item)
    {
        if (item?.Id == null)
        {
            return;
        }

        try
        {
            var httpResponseMessage = await HttpClient.DeleteAsync($"{route}/{item.Id}");

            if (httpResponseMessage != null && httpResponseMessage.IsSuccessStatusCode)
            {
                error = null;
                model.Rows.Remove(item);

                var rows = model.Rows.ToList();

                model = new GridModel<BrandDto>
                {
                    Rows = rows,
                    UseAnnotations = true
                };
            }
            else
            {
                error = "The brand could not be deleted. It may already have been removed, or is in use by a product.";
            }
        }
        catch (Exception)
        {
            error = "Unable to reach the server. Please try again.";
        }
    }
}

