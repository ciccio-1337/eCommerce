@page "/admin/role/view"
@attribute [Authorize(Roles = "Admin")]
@layout MainLayout
@inject HttpClient Http

<h2>Manage Roles</h2>
<div class="row">

    <div class="col-4">
        @if (roleResponses?.Count > 0)
        {
            <RadzenListBox @bind-Value="@value" Data="@roleResponses" Style="width:100%;min-height:200px;" TextProperty="Name" ValueProperty="Id" Change="@(args => SelectedAsync(args))" />
        }
        else
        {
            <p class="card-text"><small class="text-muted">empty</small></p>
        }
        <RadzenButton ButtonType="Radzen.ButtonType.Button" Click="@((args) => AddRole(args))" Text="New role" Icon="https" ButtonStyle="Radzen.ButtonStyle.Warning" class="btn-block btn-sm mr-2"></RadzenButton>
    </div>

    @if (model != null)
    {
        <div class="col-4">
            <EditForm Model="model" OnValidSubmit="SaveRoleAsync">
                <RadzenCard>
                    <div class="row">
                        <div class="col-md-12">
                            <label>Name</label>
                        </div>
                        <div class="col-md-12">
                            <RadzenTextBox @bind-Value="model.Name" class="col-md-12"></RadzenTextBox>
                        </div>
                    </div>
                    <hr />
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <Alert Title="Attention" ErrorList="editRoleResponse?.Errors" />
                    <div class="row row-cols-2">
                        <RadzenButton ButtonType="Radzen.ButtonType.Submit" Text="@buttonTitle" Icon="save" ButtonStyle="Radzen.ButtonStyle.Info" class="mr-2 col ml-3"></RadzenButton>
                        <RadzenButton ButtonType="Radzen.ButtonType.Button" Click="DeleteRoleAsync" Text="Delete" Icon="delete" ButtonStyle="Radzen.ButtonStyle.Danger" class="mr-3 col" ConfirmText="Are you sure you want to delete this role?" ConfirmTitle="Delete Role" ConfirmButtonStyle="Radzen.ButtonStyle.Danger"></RadzenButton>
                    </div>
                </RadzenCard>
            </EditForm>

            @if (roleUserResponse != null && roleUserResponse.Any(x => x.InRole)) 
            {
                <h4 class="mt-3">Users in role</h4>
                <RadzenDataList Data="@roleUserResponse.Where(x => x.InRole)" TItem="RoleUserResponse">
                    <Template Context="roleUser">
                        <div class="row">
                            <div class="col-10 mt-2">
                                @roleUser.Name
                            </div>
                            <div class="col-2">
                                <RadzenButton Icon="delete" Click="@((args) => RemoveRoleUserAsync(roleUser.Id))" ConfirmText="Remove this user from the role?" ConfirmTitle="Remove User" ConfirmButtonStyle="Radzen.ButtonStyle.Danger" />
                            </div>
                        </div>
                    </Template>
                </RadzenDataList>
            }
        </div>
        <div class="col-4">
            <EditForm Model="model" OnValidSubmit="SaveRoleUserAsync">
                <RadzenCard>
                    <div class="row">
                        <div class="col-md-12">
                            <label>Add User</label>
                        </div>
                        <div class="col-md-12">
                            <RadzenDropDown @bind-Value="userId" AllowClear="true" TValue="string" Data="@(roleUserResponse?.Where(x => !x.InRole))" TextProperty="Name" ValueProperty="Id" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" class="col-md-12" />
                        </div>
                    </div>
                    <hr />
                    <RadzenButton ButtonType="Radzen.ButtonType.Submit" Text="Save" Icon="save" ButtonStyle="Radzen.ButtonStyle.Info" class="btn-block mr-2"></RadzenButton>
                </RadzenCard>
            </EditForm>
        </div>
    }
</div>

@code {
    EditRoleRequest model;
    EditRoleResponse editRoleResponse;
    List<RoleDto> roleResponses = null;
    string value;
    string buttonTitle = "Save";
    List<RoleUserResponse> roleUserResponse = null;
    string userId = null;

    protected async override Task OnInitializedAsync()
    {
        try
        {
            roleResponses = await Http.GetFromJsonAsync<List<RoleDto>>("api/roles");
        }
        catch (Exception)
        {
            roleResponses = new List<RoleDto>();
        }

        StateHasChanged();
    }

    async Task SelectedAsync(object value)
    {
        if (value == null)
        {
            return;
        }

        buttonTitle = "Save";
        model = new EditRoleRequest
        {
            Id = value.ToString(),
            Name = roleResponses?.First(x=> x.Id.Equals(value.ToString())).Name ?? string.Empty
        };

        try
        {
            roleUserResponse = await Http.GetFromJsonAsync<List<RoleUserResponse>>($"api/roles/{model.Id}/users");
        }
        catch (Exception)
        {
            roleUserResponse = new List<RoleUserResponse>();
        }

        StateHasChanged();
    }

    void AddRole(MouseEventArgs args)
    {
        buttonTitle = "Add";
        model = new EditRoleRequest();
        roleUserResponse = null;
            
        StateHasChanged();
    }

    public async Task SaveRoleAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(model.Id))
            {
                editRoleResponse = await (await Http.PostAsJsonAsync<EditRoleRequest>("api/roles", model))?.Content?.ReadFromJsonAsync<EditRoleResponse>();
            }
            else
            {
                editRoleResponse = await (await Http.PutAsJsonAsync<EditRoleRequest>($"api/roles/{model.Id}", model))?.Content?.ReadFromJsonAsync<EditRoleResponse>();
            }

            if (editRoleResponse != null && editRoleResponse.IsSuccess)
            {
                if (string.IsNullOrEmpty(model.Id))
                {
                    roleResponses.Add(new RoleDto { Id = editRoleResponse.Id, Name = model.Name });
                }
                else
                {
                    roleResponses.First(x => x.Id.Equals(model.Id)).Name = model.Name;
                }

                roleUserResponse = await Http.GetFromJsonAsync<List<RoleUserResponse>>($"api/roles/{editRoleResponse.Id}/users");

                StateHasChanged();

                model = null;
            }
        }
        catch (Exception)
        {
            // Error already surfaced via editRoleResponse.Errors in the Alert component
        }
    }

    public async Task SaveRoleUserAsync()
    {
        var isSuccess = false;

        if (!string.IsNullOrEmpty(model.Id) && !string.IsNullOrEmpty(userId))
        {
            try
            {
                isSuccess = await (await Http.PutAsJsonAsync<AddRemoveRoleRequest>($"api/roles/{model.Id}/user/{userId}", new AddRemoveRoleRequest { RoleId = model.Id, UserId = userId, Add = true }))?.Content?.ReadFromJsonAsync<bool>();
            }
            catch (Exception)
            {
                // Error handled below
            }
        }

        if (isSuccess)
        {
            roleUserResponse = await Http.GetFromJsonAsync<List<RoleUserResponse>>($"api/roles/{model.Id}/users");

            StateHasChanged();
        }
    }

    public async Task RemoveRoleUserAsync(string id)
    {
        var isSuccess = false;

        if (!string.IsNullOrEmpty(model.Id) && !string.IsNullOrEmpty(id))
        {
            try
            {
                isSuccess = await (await Http.PutAsJsonAsync<AddRemoveRoleRequest>($"api/roles/{model.Id}/user/{id}", new AddRemoveRoleRequest { RoleId = model.Id, UserId = id, Add = false }))?.Content?.ReadFromJsonAsync<bool>();
            }
            catch (Exception)
            {
                // Error handled below
            }
        }

        if (isSuccess)
        {
            roleUserResponse = await Http.GetFromJsonAsync<List<RoleUserResponse>>($"api/roles/{model.Id}/users");

            StateHasChanged();
        }
    }

    public async Task DeleteRoleAsync()
    {
        if (!string.IsNullOrEmpty(model.Id))
        {
            try
            {
                await Http.DeleteAsync($"api/roles/{model.Id}");
                roleResponses?.RemoveAll(r => r.Id.Equals(model.Id));
                StateHasChanged();

                model = null;
            }
            catch (Exception)
            {
                // Error during role deletion
            }
        }
    }
}
