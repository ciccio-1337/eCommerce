@page "/admin/category/list"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<Alert Title="@error" ErrorList="new List<string>()" CSSClass="danger" />

<Grid Model="model" Title="Categories" ElementsType="CategoryDto" OnCreate="@(() => NavigationManager.NavigateTo("/admin/category/detail"))" OnEdit="@((item) => NavigationManager.NavigateTo($"/admin/category/detail/{(item as CategoryDto)?.Id}"))" OnDelete="@((item) => DeleteCategoryAsync(item as CategoryDto))" />

@code {
    string route = "api/categories";
    GridModel<CategoryDto> model;
    string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var categories = await HttpClient.GetFromJsonAsync<List<CategoryDto>>(route);

            model = new GridModel<CategoryDto>
            {
                Rows = categories ?? new List<CategoryDto>(),
                UseAnnotations = true
            };
        }
        catch (Exception)
        {
            model = new GridModel<CategoryDto>
            {
                Rows = new List<CategoryDto>(),
                UseAnnotations = true
            };
        }
    }

    async Task DeleteCategoryAsync(CategoryDto item)
    {
        if (item?.Id == null)
        {
            return;
        }

        try
        {
            var httpResponseMessage = await HttpClient.DeleteAsync($"{route}/{item.Id}");

            if (httpResponseMessage != null && httpResponseMessage.IsSuccessStatusCode)
            {
                error = null;
                
                model.Rows.Remove(item);

                var rows = model.Rows.ToList();

                model = new GridModel<CategoryDto>
                {
                    Rows = rows,
                    UseAnnotations = true
                };
            }
            else
            {
                error = "The category could not be deleted. It may already have been removed, or is in use by a product.";
            }
        }
        catch (Exception)
        {
            error = "Unable to reach the server. Please try again.";
        }
    }
}

