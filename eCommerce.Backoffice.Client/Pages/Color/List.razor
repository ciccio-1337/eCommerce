@page "/admin/color/list"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<Alert Title="@error" ErrorList="new List<string>()" CSSClass="danger" />

<Grid Model="model" Title="Colors" ElementsType="ProductColorDto" OnCreate="@(() => NavigationManager.NavigateTo("/admin/color/detail"))" OnEdit="@((item) => NavigationManager.NavigateTo($"/admin/color/detail/{(item as ProductColorDto)?.Id}"))" OnDelete="@((item) => DeleteColorAsync(item as ProductColorDto))" />

@code {
    string route = "api/colors";
    GridModel<ProductColorDto> model;
    string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var colors = await HttpClient.GetFromJsonAsync<List<ProductColorDto>>(route);

            model = new GridModel<ProductColorDto>
            {
                Rows = colors ?? new List<ProductColorDto>(),
                UseAnnotations = true
            };
        }
        catch (Exception)
        {
            model = new GridModel<ProductColorDto>
            {
                Rows = new List<ProductColorDto>(),
                UseAnnotations = true
            };
        }
    }

    async Task DeleteColorAsync(ProductColorDto item)
    {
        if (item?.Id == null)
        {
            return;
        }

        try
        {
            var httpResponseMessage = await HttpClient.DeleteAsync($"{route}/{item.Id}");

            if (httpResponseMessage != null && httpResponseMessage.IsSuccessStatusCode)
            {
                error = null;
                
                model.Rows.Remove(item);

                var rows = model.Rows.ToList();

                model = new GridModel<ProductColorDto>
                {
                    Rows = rows,
                    UseAnnotations = true
                };
            }
            else
            {
                error = "The color could not be deleted. It may already have been removed, or is in use by a product.";
            }
        }
        catch (Exception)
        {
            error = "Unable to reach the server. Please try again.";
        }
    }
}

