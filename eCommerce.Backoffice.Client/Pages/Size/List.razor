@page "/admin/size/list"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<Alert Title="@error" ErrorList="new List<string>()" CSSClass="danger" />

<Grid Model="model" Title="Sizes" ElementsType="ProductSizeDto" OnCreate="@(() => NavigationManager.NavigateTo("/admin/size/detail"))" OnEdit="@((item) => NavigationManager.NavigateTo($"/admin/size/detail/{(item as ProductSizeDto)?.Id}"))" OnDelete="@((item) => DeleteSizeAsync(item as ProductSizeDto))" />

@code {
    string route = "api/sizes";
    GridModel<ProductSizeDto> model;
    string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sizes = await HttpClient.GetFromJsonAsync<List<ProductSizeDto>>(route);

            model = new GridModel<ProductSizeDto>
            {
                Rows = sizes ?? new List<ProductSizeDto>(),
                UseAnnotations = true
            };
        }
        catch (Exception)
        {
            model = new GridModel<ProductSizeDto>
            {
                Rows = new List<ProductSizeDto>(),
                UseAnnotations = true
            };
        }
    }

    async Task DeleteSizeAsync(ProductSizeDto item)
    {
        if (item?.Id == null)
        {
            return;
        }

        try
        {
            var httpResponseMessage = await HttpClient.DeleteAsync($"{route}/{item.Id}");

            if (httpResponseMessage != null && httpResponseMessage.IsSuccessStatusCode)
            {
                error = null;
                model.Rows.Remove(item);

                var rows = model.Rows.ToList();

                model = new GridModel<ProductSizeDto>
                {
                    Rows = rows,
                    UseAnnotations = true
                };
            }
            else
            {
                error = "The size could not be deleted. It may already have been removed, or is in use by a product.";
            }
        }
        catch (Exception)
        {
            error = "Unable to reach the server. Please try again.";
        }
    }
}

